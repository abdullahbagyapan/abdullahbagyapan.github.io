---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import { siteConfig } from '../config';
---

<Layout title={`404 | ${siteConfig.title}`}>
  <section class="py-16 min-h-[60vh] flex items-center">
    <div class="container max-w-4xl mx-auto px-6">
      <Terminal title="error" class="max-w-2xl mx-auto" contentClass="text-center">
        <div class="text-destructive font-mono text-lg mb-4">
          bash: cd: {Astro.url.pathname}: No such file or directory
        </div>

        <div class="text-8xl font-bold font-mono text-primary mb-6">404</div>

        <p class="text-muted-foreground mb-6">
          The page you're looking for doesn't exist or has been moved.
        </p>

        <div class="mb-4 font-mono text-sm text-muted-foreground">Try one of these:</div>

        <div class="flex flex-wrap justify-center gap-4 font-mono text-sm">
          <a href="/" class="px-4 py-2 bg-primary text-primary-foreground rounded hover:bg-primary/90 transition-colors">
            [go home]
          </a>
          <a href="/blog" class="px-4 py-2 border border-border rounded hover:bg-card transition-colors">
            [read blog]
          </a>
        </div>
      </Terminal>
    </div>
  </section>
</Layout>
