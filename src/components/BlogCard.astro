---
import { formatDate } from '../lib/utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  slug: string;
  tags?: string[];
}

const { title, description, date, slug, tags = [] } = Astro.props;
---

<a href={`/blog/${slug}`} class="blog-card group">
  <time class="blog-card-date" datetime={date.toISOString()}>
    {formatDate(date, 'short')}
  </time>

  <h3 class="blog-card-title">{title}</h3>

  <p class="blog-card-description">
    {description}
    <span class="blog-card-arrow ml-2">→</span>
  </p>

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-3">
      {tags.map((tag) => (
        <span class="text-xs font-mono px-2 py-0.5 bg-secondary rounded text-muted-foreground">
          #{tag}
        </span>
      ))}
    </div>
  )}
</a>

<style>
  .blog-card {
    display: block;
    padding: 1.5rem;
    background-color: color-mix(in srgb, var(--color-card) 40%, transparent);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    transition: border-color 0.1s ease, box-shadow 0.1s ease, transform 0.1s ease, background-color 0.1s ease;
  }

  .blog-card:hover {
    border-color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-card) 55%, transparent);
    box-shadow: 0 4px 15px -2px rgba(0, 0, 0, 0.25);
    transform: translateY(-1px);
  }

  .blog-card-date {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
  }

  .blog-card-title {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0.5rem 0;
  }

  .blog-card:hover .blog-card-title {
    color: var(--color-primary);
  }

  .blog-card-description {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted-foreground);
    line-height: 1.6;
  }

  .blog-card-arrow {
    font-family: var(--font-mono);
    color: var(--color-primary);
  }
</style>
